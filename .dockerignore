# 런타임 이미지에 불필요한 것 제외 — 빌드 컨텍스트 축소·비밀/데이터 유출 방지.
.git
.github
.gitignore
.gitattributes

# 파이썬 캐시·테스트 산출물
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 런타임에 불필요(테스트·문서·개발 스크립트)
tests/
docs/
*.md
run_*.py

# 로컬 데이터·산출물(이미지에 굽지 않고 볼륨으로 마운트)
data/
outputs/

# 비밀·로컬 환경
.env
.env.*
!.env.example

# 가상환경·에디터
.venv/
venv/
.vscode/
.idea/
