# LLM 설정 — 키가 없으면 자동으로 더미 모드로 동작합니다(3일 차 골격 검증용).
# 실제 Agent 구현(4~7일 차)부터 키를 채워 사용하세요.

# 사용할 LLM provider: anthropic | openai | dummy
LLM_PROVIDER=dummy

# 강제 더미 모드(키가 있어도 더미로 실행). 1이면 활성화.
USE_DUMMY=1

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 실행 구조: serial(기본) | parallel — Research 이후 독립 분석 4분기를 병렬 실행해 지연 단축.
# 결과·프롬프트·비용은 직렬과 동일하고 실행 순서만 다릅니다(비교 실험용). 비우면 serial.
WORKFLOW_MODE=serial

# 실행별 예산·시간 상한(트랙 D). 상한 도달 시 이후 LLM 호출을 생략하고 fallback으로 완주합니다
# (강제 중단 아님). 0/빈값이면 해당 항목 무제한. 기본값은 정상 실행(호출 ~20·$0.01·~2분)엔
# 걸리지 않도록 넉넉합니다. 비용 급증·폭주 방지용.
# 호출 상한은 provider로 실제 나가는 '호출 시도' 기준입니다 — JSON 파싱 재호출·provider 재시도도
# 각각 1건으로 셉니다(실제 청구에 가깝게). 실행 결과의 budget.spent.provider_attempts로 확인.
BUDGET_MAX_LLM_CALLS=50
BUDGET_MAX_COST_USD=1.0
BUDGET_MAX_WALL_MS=600000

# 데모 도구(관리자 페이지 /admin + 요청 단위 장애 주입) 활성화. 기본 0=off.
# off면 /admin 은 404 이고, 요청의 demo_fail_nodes 도 무시됩니다(외부 사용자가 특정 Agent를
# 의도적으로 실패시키는 것 방지). 발표·시연 때만 1로 켜세요.
# 운영자가 직접 주는 DEMO_FAIL_NODES / DEMO_FAIL_REASON 환경변수는 이 게이트와 무관하게 동작합니다.
ENABLE_DEMO_TOOLS=0

# 웹 검색 (Tavily) — Research Agent 근거 확보용. 비우면 검색 없이 LLM 지식 기반으로 동작.
# 키 발급: https://app.tavily.com (무료 티어 제공)
TAVILY_API_KEY=

# 관측성 (Langfuse) — LLM 호출별 지연/토큰을 대시보드로 추적. 비우면 자동 비활성.
# 키 발급: https://cloud.langfuse.com (무료 티어). 셀프호스팅이면 HOST를 자기 주소로.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
