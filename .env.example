# LLM 설정 — 키가 없으면 자동으로 더미 모드로 동작합니다(3일 차 골격 검증용).
# 실제 Agent 구현(4~7일 차)부터 키를 채워 사용하세요.

# 사용할 LLM provider: anthropic | openai | dummy
LLM_PROVIDER=dummy

# 강제 더미 모드(키가 있어도 더미로 실행). 1이면 활성화.
USE_DUMMY=1

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 실행 구조: serial(기본) | parallel — Research 이후 독립 분석 4분기를 병렬 실행해 지연 단축.
# 결과·프롬프트·비용은 직렬과 동일하고 실행 순서만 다릅니다(비교 실험용). 비우면 serial.
WORKFLOW_MODE=serial

# 실행별 예산·시간 상한(트랙 D). 상한 도달 시 이후 LLM 호출을 생략하고 fallback으로 완주합니다
# (강제 중단 아님). 0/빈값이면 해당 항목 무제한. 기본값은 정상 실행(호출 ~20·$0.01·~2분)엔
# 걸리지 않도록 넉넉합니다. 비용 급증·폭주 방지용.
# 호출 상한은 provider로 실제 나가는 '호출 시도' 기준입니다 — JSON 파싱 재호출·provider 재시도도
# 각각 1건으로 셉니다(실제 청구에 가깝게). 실행 결과의 budget.spent.provider_attempts로 확인.
BUDGET_MAX_LLM_CALLS=50
BUDGET_MAX_COST_USD=1.0
BUDGET_MAX_WALL_MS=600000

# 공개 배포용 요청 상한(상시 트랙 E). 전부 0=비활성이 기본이라 로컬·CI 동작은 바뀌지 않습니다.
# budget.* 는 '실행 1건 안의' 상한이고, 아래는 '실행이 몇 번 일어나는가'를 막습니다.
# 공개 주소(Cloud Run 등)에서만 켜세요 — 자세한 값·근거는 DEPLOY.md 의 GCP 섹션.
# ⚠ 카운터는 프로세스 메모리라 --max-instances=1 전제입니다(여러 인스턴스면 상한이 곱해집니다).
PUBLIC_MAX_RUNS_PER_IP=0
PUBLIC_IP_WINDOW_SEC=3600
PUBLIC_MAX_RUNS_PER_DAY=0
PUBLIC_MAX_COST_PER_DAY_USD=0

# 데모 도구(관리자 페이지 /admin + 요청 단위 장애 주입) 활성화. 기본 0=off.
# off면 /admin 은 404 이고, 요청의 demo_fail_nodes 도 무시됩니다(외부 사용자가 특정 Agent를
# 의도적으로 실패시키는 것 방지). 발표·시연 때만 1로 켜세요.
# 운영자가 직접 주는 DEMO_FAIL_NODES / DEMO_FAIL_REASON 환경변수는 이 게이트와 무관하게 동작합니다.
ENABLE_DEMO_TOOLS=0

# 제한된 동적 실행(로드맵 2-5): Research가 '근거가 부족하다'고 스스로 보고한 항목에 한해 추가
# 웹검색을 수행합니다. 실행당 추가 검색 최대 횟수(기본 2, 0=기능 비활성). 추가 LLM 호출은 최대 1회,
# 실행 예산(BUDGET_MAX_*) 상한에 걸리면 생략합니다. 더미 모드·검색 비활성이면 동작하지 않습니다.
DYNAMIC_MAX_GAP_SEARCHES=2

# Artifact Contract 읽기 모드(로드맵 2-2). Agent 산출물을 어디서 읽을지 정합니다.
#   legacy(기본)    기존 평면 결과 키만 읽음 — 전환 전과 완전히 동일한 동작
#   prefer_artifact Artifact 우선, 못 쓰면(없음/빈값/failed) 평면 키로 폴백 + 사유 warning
#   artifact_only   Artifact 만 읽음 — 못 쓰면 폴백 대신 명시적 실패(평면 키 제거 전 검증용)
# 전환 후 문제가 생기면 코드를 되돌리지 말고 이 값을 legacy 로 바꾼 뒤 **재시작**하세요
# (rollback 장치). 이 파일은 프로세스 시작 시 1회만 로드되므로 실행 중에는 반영되지 않습니다.
# 현재 서버가 어느 모드로 도는지: GET /health 의 artifact_read_mode
#   (artifact_read_mode_invalid=true 면 값이 있는데 못 알아들어 legacy 로 떨어진 것 = 오타 신호)
# 실행 결과의 artifact_read(usable/unusable)로 '전환하면 얼마나 폴백이 날지'를 미리 볼 수 있고,
# artifact_parity(matched/expected·ok)로 Artifact 가 평면 결과와 일치하는지 확인합니다.
# ⚠ 현재는 문서 생성·검증 소비자만 전환됐습니다. Agent 간 읽기와 표시 계층은 아직 평면 키를
#   직접 읽으므로, prefer_artifact 로 바꿔도 그 경로들은 영향을 받지 않습니다.
ARTIFACT_READ_MODE=legacy

# 웹 검색 (Tavily) — Research Agent 근거 확보용. 비우면 검색 없이 LLM 지식 기반으로 동작.
# 키 발급: https://app.tavily.com (무료 티어 제공)
TAVILY_API_KEY=

# 관측성 (Langfuse) — LLM 호출별 지연/토큰을 대시보드로 추적. 비우면 자동 비활성.
# 키 발급: https://cloud.langfuse.com (무료 티어). 셀프호스팅이면 HOST를 자기 주소로.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
